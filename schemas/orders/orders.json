{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Response schema for Razorpay Order objects. Note: Razorpay Sandbox currently accepts receipt and notes values that exceed documented request constraints. These constraints are intentionally not enforced here because such values may be persisted and returned by subsequent API responses. Structural and type validation remain enforced.",
    "title": "Razorpay Order Response",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "entity",
        "amount",
        "amount_paid",
        "amount_due",
        "currency",
        "receipt",
        "status",
        "attempts",
        "notes",
        "created_at",
        "offer_id"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^order_[A-Za-z0-9]{14}$"
        },
        "entity": {
            "const": "order"
        },
        "amount": {
            "type": "integer",
            "minimum": 100
        },
        "amount_paid": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0
        },
        "amount_due": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 0
        },
        "currency": {
            "type": "string",
            "maxLength": 3
        },
        "receipt": {
            "description": "The Sandbox currently accepts receipt values exceeding the documented request constraint. Length validation is intentionally not enforced in the response schema.",
            "type": [
                "string",
                "null"
            ]
        },
        "offer_id": {
            "type": [
                "string",
                "null"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "created",
                "attempted",
                "paid"
            ]
        },
        "attempts": {
            "type": "integer",
            "minimum": 0
        },
        "notes": {
            "description": "The Sandbox currently accepts notes exceeding the documented limits. Length and property-count constraints are intentionally not enforced in the response schema.",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "propertyNames": {
                        "type": [
                            "string",
                            "array"
                        ]
                    }
                },
                {
                    "type": "array",
                    "maxItems": 0
                }
            ]
        },
        "created_at": {
            "type": "integer",
            "minimum": 0
        },
        "description": {
            "type": [
                "string",
                "null"
            ]
        },
        "checkout": {
            "type": [
                "object",
                "null"
            ]
        },
        "offers": {
            "type": [
                "array",
                "null"
            ],
            "items": {
                "type": "string"
            }
        }
    }
}